{
  "realm": "notification-hub",
  "enabled": true,
  "displayName": "Notification Hub",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "roles": {
    "realm": [
      {
        "name": "notification-sender",
        "description": "Send notifications via the hub API",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "notification-admin",
        "description": "Manage templates and admin endpoints",
        "composite": false,
        "clientRole": false
      }
    ]
  },
  "clients": [
    {
      "clientId": "notification-hub-console",
      "enabled": true,
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": true,
      "redirectUris": [
        "https://notification.optimizesolux.com/*",
        "http://localhost:4200/*"
      ],
      "webOrigins": ["+"]
    },
    {
      "clientId": "notification-hub-api",
      "enabled": true,
      "publicClient": false,
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "secret": "CHANGE_ME_IN_VAULT"
    },
    {
      "clientId": "biocollect-notification-sender",
      "name": "BioCollect Notification Sender",
      "description": "BioCollect API — Client Credentials to send notifications",
      "enabled": true,
      "publicClient": false,
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "secret": "CHANGE_ME_IN_VAULT",
      "protocol": "openid-connect",
      "defaultClientScopes": ["web-origins", "roles"],
      "optionalClientScopes": [],
      "protocolMappers": [
        {
          "name": "tenant_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": {
            "claim.value": "biocollect",
            "userinfo.token.claim": "false",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "claim.name": "tenant_id",
            "jsonType.label": "String"
          }
        },
        {
          "name": "audience-notification-hub-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "notification-hub-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "s2a",
      "name": "Amicale S2A Notification Sender",
      "description": "S2A API — Client Credentials for OTP activation via Notification Hub",
      "enabled": true,
      "publicClient": false,
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "secret": "CHANGE_ME_IN_VAULT",
      "protocol": "openid-connect",
      "defaultClientScopes": ["web-origins", "roles"],
      "optionalClientScopes": [],
      "protocolMappers": [
        {
          "name": "tenant_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": {
            "claim.value": "s2a",
            "userinfo.token.claim": "false",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "claim.name": "tenant_id",
            "jsonType.label": "String"
          }
        },
        {
          "name": "audience-notification-hub-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "notification-hub-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "service-account-biocollect-notification-sender",
      "enabled": true,
      "serviceAccountClientId": "biocollect-notification-sender",
      "clientRoles": {},
      "realmRoles": ["notification-sender"]
    },
    {
      "username": "service-account-s2a",
      "enabled": true,
      "serviceAccountClientId": "s2a",
      "clientRoles": {},
      "realmRoles": ["notification-sender"]
    }
  ]
}
