# Source this file only on the Contabo host after obtaining values from the secret manager.
# Never commit the populated file. The provisioner writes the canonical values to Vault.

# Common-infra administrative credentials, loaded from /opt/optimizesolux/common-infra/.env.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=replace-with-common-infra-minio-root-secret
VAULT_TOKEN=replace-with-temporary-vault-operator-token

# ImpactC database and internal cryptography.
IMPACTC_DB_USER=impactc
IMPACTC_DB_PASSWORD=replace-with-unique-impactc-database-password
IMPACTC_JWT_ACCESS_SECRET=replace-with-random-64-byte-access-secret
IMPACTC_JWT_REFRESH_SECRET=replace-with-random-64-byte-refresh-secret
# Exactly 32 ASCII bytes; do not use this example as a production key.
IMPACTC_CHAT_ENCRYPTION_KEY=replace-with-exactly-32-byte-key

# ImpactC uses the shared Redis service, with a dedicated logical database and queue prefix.
IMPACTC_REDIS_PASSWORD=replace-with-common-redis-password

# Dedicated MinIO identities. They must differ from root and from each other.
IMPACTC_S3_ACCESS_KEY=impactc-media
IMPACTC_S3_SECRET_KEY=replace-with-random-media-secret
IMPACTC_RELEASES_ACCESS_KEY=impactc-mobile-releases
IMPACTC_RELEASES_SECRET_KEY=replace-with-random-apk-publisher-secret

# notification-hub is a separate service realm and is not used by Keycloak identity emails.
NOTIFICATION_HUB_OAUTH_CLIENT_SECRET=replace-with-notification-hub-service-secret
NOTIFICATION_HUB_BASE_URL=https://notification-api.optimizesolux.com
NOTIFICATION_HUB_FROM=notifications@optimizesolux.com
NOTIFICATION_HUB_OAUTH_TOKEN_URL=https://auth.optimizesolux.com/realms/notification-hub/protocol/openid-connect/token
NOTIFICATION_HUB_OAUTH_CLIENT_ID=impactc-notification-sender

# Backoffice Keycloak (realm impactc), which is distinct from notification-hub.
IMPACTC_KEYCLOAK_ISSUER=https://auth.optimizesolux.com/realms/impactc
IMPACTC_KEYCLOAK_AUDIENCE=impactc-backoffice
