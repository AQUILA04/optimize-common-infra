# =============================================================================
# Optimize Common Infra — Contabo .env template
# Copy to /opt/optimizesolux/common-infra/.env (never commit secrets).
# =============================================================================

# --- Domain suffix for Traefik hosts ---
DOMAIN=optimizesolux.com

# --- Keycloak ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_keycloak_admin
KEYCLOAK_HOSTNAME=auth.optimizesolux.com
KEYCLOAK_IMAGE=ghcr.io/aquila04/optimize-common-infra-keycloak:latest
KC_SPI_THEME_WELCOME_THEME=optimizesolux
KEYCLOAK_DB_PASSWORD=CHANGE_ME_keycloak_db

# --- Redis ---
REDIS_PASSWORD=CHANGE_ME_redis

# --- Artemis ---
ARTEMIS_USER=artemis
ARTEMIS_PASSWORD=CHANGE_ME_artemis

# --- MinIO ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=CHANGE_ME_minio
MINIO_HOSTNAME=s3.optimizesolux.com
MINIO_CONSOLE_HOSTNAME=s3-console.optimizesolux.com

# --- Mailpit ---
MAILPIT_HOSTNAME=mail.optimizesolux.com

# --- Vault ---
VAULT_HOSTNAME=vault.optimizesolux.com
# File storage path on host (created by install.sh)
VAULT_DATA_PATH=/opt/optimizesolux/common-infra/vault/data

# --- pgAdmin ---
PGADMIN_HOSTNAME=pgadmin.optimizesolux.com
PGADMIN_DEFAULT_EMAIL=admin@optimizesolux.com
PGADMIN_DEFAULT_PASSWORD=CHANGE_ME_pgadmin

# --- Grafana ---
GRAFANA_HOSTNAME=grafana.optimizesolux.com
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_grafana

# --- Prometheus / Artemis console / others ---
PROMETHEUS_HOSTNAME=prometheus.optimizesolux.com
ARTEMIS_CONSOLE_HOSTNAME=artemis.optimizesolux.com
EUREKA_HOSTNAME=eureka.optimizesolux.com
GATEWAY_HOSTNAME=gateway.optimizesolux.com
RABBITMQ_HOSTNAME=rabbitmq.optimizesolux.com
JAEGER_HOSTNAME=jaeger.optimizesolux.com

# --- RabbitMQ (profile rabbitmq) ---
RABBITMQ_DEFAULT_USER=optimizesolux
RABBITMQ_DEFAULT_PASS=CHANGE_ME_rabbitmq

# --- Kafka (profile kafka) ---
# no secrets by default

# --- Custom images (CI) ---
GATEWAY_IMAGE=ghcr.io/aquila04/optimize-common-infra-gateway:latest
EUREKA_IMAGE=ghcr.io/aquila04/optimize-common-infra-eureka:latest

# --- GHCR (optional pull) ---
# GHCR_USERNAME=
# GHCR_TOKEN=
